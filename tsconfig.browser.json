{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2020",
    "module": "ES2020",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist/browser",
    "rootDir": "ts/"
  }
}
