{
  "compilerOptions": {
    "declaration": true,  
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "target": "ES2020",       
    "rootDir": "src",
    "outDir": "dist",       
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"]
}
