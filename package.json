{
  "name": "gggcode",
  "version": "0.1.0",
  "description": "G Code like general purpose meta-language.",
  "main": "dist/node/index.js",
  "bin": {
    "ggg": "./bin/ggg.js"
  },
  "exports": {
    ".": {
      "browser": "./dist/browser/index.js",
      "import": "./dist/node/index.js",
      "require": "./dist/node/index.js"
    },
    "./ggg": {
      "browser": "./dist/browser/ggg.js",
      "import": "./dist/node/ggg.js",
      "require": "./dist/node/ggg.js"
    },
    "./ggggx": {
      "browser": "./dist/browser/ggggx.js",
      "import": "./dist/node/ggggx.js",
      "require": "./dist/node/ggggx.js"
    },
    "./ggggxCLI": {
      "browser": "./dist/browser/ggggx-cli.js",
      "import": "./dist/node/ggggx-cli.js",
      "require": "./dist/node/ggggx-cli.js"
    },
    "./math": {
      "browser": "./dist/browser/common/math.js",
      "import": "./dist/node/common/math.js",
      "require": "./dist/node/common/math.js"
    },
    "./SavePNG": {
      "browser": "./dist/browser/ggggx/SavePNG.js",
      "import": "./dist/node/ggggx/SavePNG.js",
      "require": "./dist/node/ggggx/SavePNG.js"
    },
    "./LoadPNG": {
      "browser": "./dist/browser/ggggx/LoadPNG.js",
      "import": "./dist/node/ggggx/LoadPNG.js",
      "require": "./dist/node/ggggx/LoadPNG.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run build:ts && npm run build:pio",
    "build:pio": "npm run build:cxx_defs && bun run ts/cxx/buildPlatformio.script.ts",
    "build:cxx_defs": "bun run ts/cxx/buildCxxDefs.script.ts",
    "build:ts": "npm run build:ts:browser && npm run build:ts:node",
    "build:ts:browser": "tsc -p tsconfig.browser.json",
    "build:ts:node": "tsc -p tsconfig.node.json",
    "test": "npm run test:ts",
    "test:ts": "jest",
    "test:ts:watch": "jest --watchAll --bail",
    "test:pio": "npm run build:pio && cd dist/pio/ && pio test",
    "lint:ts": "eslint ts/**/*.ts",
    "lint:ts:fix": "eslint --fix ts/**/*.ts"
  },
  "author": "Samm Zuest Cooper <koopero@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "bun": "^1.2.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "deindent": "^0.1.0",
    "fast-png": "^6.2.0",
    "optimist": "^0.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-reconciler": "^0.31.0",
    "ws": "^8.16.0"
  }
}
