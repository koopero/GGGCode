{
  "name": "gggcode",
  "version": "0.3.0",
  "description": "G Code like general purpose meta-language.",
  "keywords": [
    "gcode",
    "g-code",
    "meta-language",
    "dsl",
    "parser",
    "language",
    "matrix",
    "graphics"
  ],
  "homepage": "https://github.com/koopero/GGGCode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koopero/GGGCode.git"
  },
  "bugs": {
    "url": "https://github.com/koopero/GGGCode/issues"
  },
  "main": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "bin": {
    "ggg": "bin/ggg.js"
  },
  "files": [
    "bin/",
    "cxx/include/",
    "dist/node/",
    "dist/browser/",
    "docs/",
    "example/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/node/index.d.ts",
      "browser": "./dist/browser/index.js",
      "import": "./dist/node/index.js",
      "require": "./dist/node/index.js"
    },
    "./ggg": {
      "types": "./dist/node/ggg.d.ts",
      "browser": "./dist/browser/ggg.js",
      "import": "./dist/node/ggg.js",
      "require": "./dist/node/ggg.js"
    },
    "./ParseLine": {
      "types": "./dist/node/ggg/ParseLine.d.ts",
      "browser": "./dist/browser/ggg/ParseLine.js",
      "import": "./dist/node/ggg/ParseLine.js",
      "require": "./dist/node/ggg/ParseLine.js"
    },
    "./KitchenSinkMachine": {
      "types": "./dist/node/KitchenSinkMachine.d.ts",
      "browser": "./dist/browser/KitchenSinkMachine.js",
      "import": "./dist/node/KitchenSinkMachine.js",
      "require": "./dist/node/KitchenSinkMachine.js"
    },
    "./Format": {
      "types": "./dist/node/ggg/Format.d.ts",
      "browser": "./dist/browser/ggg/Format.js",
      "import": "./dist/node/ggg/Format.js",
      "require": "./dist/node/ggg/Format.js"
    },
    "./ggggx": {
      "types": "./dist/node/ggggx.d.ts",
      "browser": "./dist/browser/ggggx.js",
      "import": "./dist/node/ggggx.js",
      "require": "./dist/node/ggggx.js"
    },
    "./math": {
      "types": "./dist/node/common/math.d.ts",
      "browser": "./dist/browser/common/math.js",
      "import": "./dist/node/common/math.js",
      "require": "./dist/node/common/math.js"
    },
    "./SavePNG": {
      "types": "./dist/node/ggggx/SavePNG.d.ts",
      "browser": "./dist/browser/ggggx/SavePNG.js",
      "import": "./dist/node/ggggx/SavePNG.js",
      "require": "./dist/node/ggggx/SavePNG.js"
    },
    "./LoadPNG": {
      "types": "./dist/node/ggggx/LoadPNG.d.ts",
      "browser": "./dist/browser/ggggx/LoadPNG.js",
      "import": "./dist/node/ggggx/LoadPNG.js",
      "require": "./dist/node/ggggx/LoadPNG.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build:ts && npm run check:codegen",
    "build": "npm run build:ts && npm run build:pio",
    "build:pio": "npm run build:cxx_defs && npm run build:conformance && bun run ts/cxx/buildPlatformio.script.ts",
    "build:cxx_defs": "bun run ts/cxx/buildCxxDefs.script.ts",
    "build:conformance": "bun run ts/cxx/buildConformance.script.ts && bun run ts/cxx/buildDocs.script.ts && bun run ts/cxx/buildCommands.script.ts",
    "build:docs": "bun run ts/cxx/buildDocs.script.ts",
    "build:commands": "bun run ts/cxx/buildCommands.script.ts",
    "check:codegen": "bun run ts/cxx/buildCxxDefs.script.ts --check && bun run ts/cxx/buildConformance.script.ts --check && bun run ts/cxx/buildDocs.script.ts --check && bun run ts/cxx/buildCommands.script.ts --check",
    "build:ts": "npm run build:ts:browser && npm run build:ts:node",
    "build:ts:browser": "tsc -p tsconfig.browser.json",
    "build:ts:node": "tsc -p tsconfig.node.json",
    "test": "npm run test:ts",
    "test:ts": "jest",
    "test:cxx-config": "bun run ts/cxx/testConfigurations.script.ts",
    "test:ts:watch": "jest --watchAll --bail",
    "test:pio": "npm run test:cxx-config && npm run build:pio && cd dist/pio/ && pio test",
    "lint:ts": "eslint ts/**/*.ts",
    "lint:ts:fix": "eslint --fix ts/**/*.ts"
  },
  "author": "Samm Zuest Cooper <koopero@gmail.com>",
  "license": "ISC",
  "engines": {
    "node": ">=18.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "bun": "^1.2.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "fast-png": "^6.2.0",
    "ws": "^8.21.1"
  }
}
